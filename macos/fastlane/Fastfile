# ============================================================
# Fastfile - macOS App Store Connect デプロイ自動化
# ============================================================

default_platform(:mac)

platform :mac do
  desc "2.5.0のリリースノートとスクリーンショットをApp Store Connectへ反映"
  lane :upload_store_listing do
    api_key = app_store_connect_api_key(
      key_id: "7LK8SRK8KU",
      issuer_id: "714bd8a7-7a2b-4efb-893d-c5eb74b71125",
      key_filepath: "/Users/ryuya/Documents/apple_cert/AuthKey_7LK8SRK8KU.p8"
    )

    project_root = File.expand_path("../..", __dir__)
    deliver(
      api_key: api_key,
      app_identifier: "net.ryuya-dev.mnc",
      app_version: "2.5.0",
      platform: "osx",
      metadata_path: File.join(project_root, "fastlane/app-store/macos/metadata"),
      screenshots_path: File.join(project_root, "fastlane/app-store/macos/screenshots"),
      skip_binary_upload: true,
      skip_metadata: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "2.5.0 (34) のTestFlightテスト内容を日本語・英語で更新"
  lane :update_testflight_notes do
    api_key = app_store_connect_api_key(
      key_id: "7LK8SRK8KU",
      issuer_id: "714bd8a7-7a2b-4efb-893d-c5eb74b71125",
      key_filepath: "/Users/ryuya/Documents/apple_cert/AuthKey_7LK8SRK8KU.p8"
    )

    project_root = File.expand_path("../..", __dir__)
    pilot(
      api_key: api_key,
      app_identifier: "net.ryuya-dev.mnc",
      app_platform: "osx",
      app_version: "2.5.0",
      build_number: "34",
      distribute_only: true,
      skip_submission: true,
      distribute_external: false,
      localized_build_info: {
        "ja" => {
          whats_new: File.read(File.join(project_root, "fastlane/app-store/macos/metadata/ja/release_notes.txt"))
        },
        "en-US" => {
          whats_new: File.read(File.join(project_root, "fastlane/app-store/macos/metadata/en-US/release_notes.txt"))
        }
      }
    )
  end

  # ============================================================
  # 事前処理: 証明書とプロビジョニングプロファイルを取得
  # ============================================================
  desc "証明書とプロビジョニングプロファイルを同期"
  lane :sync_certificates do
    if is_ci
      # CI環境用: 一時的なKeychainを作成
      create_keychain(
        name: "ci_keychain",
        password: ENV["MATCH_PASSWORD"],
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )
      
      # CI環境用のAPI Key設定
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true
      )

      match(
        type: "appstore",
        platform: "macos",
        readonly: true,
        keychain_name: "ci_keychain",
        keychain_password: ENV["MATCH_PASSWORD"],
        api_key: api_key,
        additional_cert_types: ["mac_installer_distribution"]
      )
    else
      # ローカル環境用: API Key認証を使用
      api_key = app_store_connect_api_key(
        key_id: "7LK8SRK8KU",
        issuer_id: "714bd8a7-7a2b-4efb-893d-c5eb74b71125",
        key_filepath: "/Users/ryuya/Documents/apple_cert/AuthKey_7LK8SRK8KU.p8"
      )
      
      match(
        git_url: "https://github.com/ryuya0124/Apple_Certificates",
        type: "appstore",
        platform: "macos",
        readonly: true,
        api_key: api_key,
        additional_cert_types: ["mac_installer_distribution"]
      )
    end
  end

  # ============================================================
  # 署名ありAppビルド（アップロードなし）
  # ============================================================
  desc "署名ありAppをビルド"
  lane :build_signed do
    # 証明書を同期
    sync_certificates

    # プロジェクトルートのパスを取得（macos/fastlane から2階層上）
    project_root = File.expand_path("../..", __dir__)
    pubspec_path = File.join(project_root, "pubspec.yaml")
    
    # pubspec.yamlからバージョン情報を取得
    pubspec_content = File.read(pubspec_path)
    version_match = pubspec_content.match(/version:\s*(\d+\.\d+\.\d+)\+(\d+)/)
    
    if version_match
      version_name = version_match[1]
      build_number = version_match[2]
      UI.message("📦 pubspec.yaml から取得: バージョン #{version_name}, ビルド番号 #{build_number}")
    else
      UI.user_error!("pubspec.yaml からバージョン情報を取得できませんでした")
    end

    # Info.plistを更新
    update_info_plist(
      plist_path: "Runner/Info.plist",
      block: proc do |plist|
        plist["CFBundleVersion"] = build_number
        plist["CFBundleShortVersionString"] = version_name
      end
    )
    UI.message("📝 Info.plist を更新: バージョン #{version_name}, ビルド番号 #{build_number}")

    # Appをビルド
    build_mac_app(
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/macos/Build/Products/Release",
      output_name: "Rytmica",
    )

    UI.success("署名ありAppビルド完了")
  end

  # ============================================================
  # TestFlightへのアップロード（ビルド済みAppを使用）CI用
  # ============================================================
  desc "ビルド済みAppをTestFlightにアップロード"
  lane :upload_testflight do
    # プロジェクトルートのパスを取得（macos/fastlane から2階層上）
    project_root = File.expand_path("../..", __dir__)
    pubspec_path = File.join(project_root, "pubspec.yaml")
    
    # pubspec.yamlからバージョン情報を取得
    pubspec_content = File.read(pubspec_path)
    version_match = pubspec_content.match(/version:\s*(\d+\.\d+\.\d+)\+(\d+)/)
    
    if version_match
      version_name = version_match[1]
      build_number = version_match[2]
      UI.message("📦 pubspec.yaml から取得: バージョン #{version_name}, ビルド番号 #{build_number}")
    else
      version_name = "不明"
      build_number = "不明"
    end

    # App Store Connect API認証設定
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]),
      is_key_content_base64: false
    )

    # TestFlightにアップロード（エラーハンドリング付き）
    begin
      pilot(
        api_key: api_key,
        pkg: "../build/macos/Build/Products/Release/Rytmica.pkg",
        skip_waiting_for_build_processing: true
      )
      UI.success("✅ TestFlightへのアップロード完了")
    rescue => e
      error_msg = e.message.to_s
      if error_msg.include?("redundant binary upload") || 
         error_msg.include?("already exists") || 
         error_msg.include?("This build already exists") ||
         error_msg.include?("has already been uploaded") ||
         error_msg.include?("must be higher than") ||
         error_msg.include?("DUPLICATE") ||
         error_msg.include?("has already been used")
        UI.user_error!("❌ ビルド番号 #{build_number} は既にTestFlightにアップロード済みです！\n\n" \
          "📝 解決方法: pubspec.yaml の version を更新してください。\n" \
          "   現在: version: #{version_name}+#{build_number}\n" \
          "   変更例: version: #{version_name}+#{build_number.to_i + 1}")
      else
        raise e
      end
    end
  end

  # ============================================================
  # ローカル用: TestFlightへのアップロードのみ（ビルド済みAppを使用）
  # ============================================================
  desc "ローカルからビルド済みAppをTestFlightにアップロード"
  lane :upload_local do
    # プロジェクトルートのパスを取得（macos/fastlane から2階層上）
    project_root = File.expand_path("../..", __dir__)
    pubspec_path = File.join(project_root, "pubspec.yaml")
    
    # pubspec.yamlからバージョン情報を取得
    pubspec_content = File.read(pubspec_path)
    version_match = pubspec_content.match(/version:\s*(\d+\.\d+\.\d+)\+(\d+)/)
    
    if version_match
      version_name = version_match[1]
      build_number = version_match[2]
      UI.message("📦 pubspec.yaml から取得: バージョン #{version_name}, ビルド番号 #{build_number}")
    else
      version_name = "不明"
      build_number = "不明"
    end

    # ローカル用のApp Store Connect API認証設定
    api_key = app_store_connect_api_key(
      key_id: "7LK8SRK8KU",
      issuer_id: "714bd8a7-7a2b-4efb-893d-c5eb74b71125",
      key_filepath: "/Users/ryuya/Documents/apple_cert/AuthKey_7LK8SRK8KU.p8"
    )

    # TestFlightにアップロード（エラーハンドリング付き）
    begin
      pilot(
        api_key: api_key,
        pkg: "../build/macos/Build/Products/Release/Rytmica.pkg",
        skip_waiting_for_build_processing: true
      )
      UI.success("✅ ローカルからTestFlightへのアップロード完了")
    rescue => e
      error_msg = e.message.to_s
      if error_msg.include?("redundant binary upload") || 
         error_msg.include?("already exists") || 
         error_msg.include?("This build already exists") ||
         error_msg.include?("has already been uploaded") ||
         error_msg.include?("must be higher than") ||
         error_msg.include?("DUPLICATE") ||
         error_msg.include?("has already been used")
        UI.user_error!("❌ ビルド番号 #{build_number} は既にTestFlightにアップロード済みです！\n\n" \
          "📝 解決方法: pubspec.yaml の version を更新してください。\n" \
          "   現在: version: #{version_name}+#{build_number}\n" \
          "   変更例: version: #{version_name}+#{build_number.to_i + 1}")
      else
        raise e
      end
    end
  end

  # ============================================================
  # TestFlightへのビルド+アップロード（従来のbetaレーン）CI用
  # ============================================================
  desc "TestFlightにビルドをアップロード"
  lane :beta do
    build_signed
    upload_testflight
  end

  # ============================================================
  # ローカル環境用: TestFlightへのビルド+アップロード
  # ============================================================
  desc "ローカルからTestFlightにビルドをアップロード"
  lane :local_testflight do
    # 証明書を同期


    # プロジェクトルートのパスを取得（macos/fastlane から2階層上）
    project_root = File.expand_path("../..", __dir__)
    pubspec_path = File.join(project_root, "pubspec.yaml")
    
    # pubspec.yamlからバージョン情報を取得
    pubspec_content = File.read(pubspec_path)
    version_match = pubspec_content.match(/version:\s*(\d+\.\d+\.\d+)\+(\d+)/)
    
    if version_match
      version_name = version_match[1]
      build_number = version_match[2]
      UI.message("📦 pubspec.yaml から取得: バージョン #{version_name}, ビルド番号 #{build_number}")
    else
      UI.user_error!("❌ pubspec.yaml からバージョン情報を取得できませんでした。version: X.Y.Z+N の形式で指定されているか確認してください。")
    end

    # pubspec.yamlのビルド番号をInfo.plistに直接設定（インクリメントなし）


    # Appをビルド
    # Appをビルド
    build_mac_app(
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { 
          "net.ryuya-dev.mnc" => "match AppStore net.ryuya-dev.mnc macos"
        }
      },
      output_directory: "../build/macos/Build/Products/Release",
      output_name: "Rytmica",
      clean: false,
      xcargs: "FLUTTER_BUILD_NAME=#{version_name} FLUTTER_BUILD_NUMBER=#{build_number}"
    )

    # ローカル用のApp Store Connect API認証設定
    api_key = app_store_connect_api_key(
      key_id: "7LK8SRK8KU",
      issuer_id: "714bd8a7-7a2b-4efb-893d-c5eb74b71125",
      key_filepath: "/Users/ryuya/Documents/apple_cert/AuthKey_7LK8SRK8KU.p8"
    )

    # TestFlightにアップロード（エラーハンドリング付き）
    begin
      pilot(
        api_key: api_key,
        pkg: "../build/macos/Build/Products/Release/Rytmica.pkg",
        skip_waiting_for_build_processing: true
      )
      UI.success("✅ ローカルからTestFlightへのアップロード完了")
    rescue => e
      error_msg = e.message.to_s
      if error_msg.include?("redundant binary upload") || 
         error_msg.include?("already exists") || 
         error_msg.include?("This build already exists") ||
         error_msg.include?("has already been uploaded") ||
         error_msg.include?("must be higher than") ||
         error_msg.include?("DUPLICATE") ||
         error_msg.include?("has already been used")
        UI.user_error!("❌ ビルド番号 #{build_number} は既にTestFlightにアップロード済みです！\n\n" \
          "📝 解決方法: pubspec.yaml の version を更新してください。\n" \
          "   現在: version: #{version_name}+#{build_number}\n" \
          "   変更例: version: #{version_name}+#{build_number.to_i + 1}")
      else
        raise e
      end
    end
  end
end
